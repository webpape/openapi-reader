{
   "name": "openapi-reader",
   "version": "0.0.1",
   "description": "The best reader for Openapi",
   "productName": "Openapi Reader",
   "author": "Patrick Perron <webpape@gmail.com>",
   "private": true,
   "scripts": {
      "import": "mkdir -p specs && cp ../../ezmax/ezmax.api/appcluster01/specs/internal.json specs/internal.json || echo 'Import ignoré : source interne absente, specs/internal.json est conservé.'",
      "lint": "eslint --ext .js,.ts,.vue ./",
      "format": "prettier --write \"**/*.{js,ts,vue,scss,html,md,json}\" --ignore-path .gitignore",
      "test": "echo \"No test specified\" && exit 0",
      "dev": "yarn import && vite",
      "build": "yarn import && vite build",
      "build:ezmax": "yarn build && cp -r dist G:/ezmax.api/appcluster01/api-reader/dist",
      "preview": "vite preview",
      "typecheck": "vue-tsc --noEmit"
   },
   "dependencies": {
      "@primeuix/themes": "^2.0.2",
      "axios": "^1.7.7",
      "highlight.js": "^11.10.0",
      "marked": "^14.1.3",
      "openapi-types": "^12.1.0",
      "pinia": "^2.3.1",
      "pinia-plugin-persistedstate": "^2.2.0",
      "primeicons": "^7.0.0",
      "primevue": "^4.5.4",
      "vue": "^3.5.12",
      "vue-i18n": "^9.14.4",
      "vue-router": "^4.5.0"
   },
   "devDependencies": {
      "@types/node": "^22.15.3",
      "@typescript-eslint/eslint-plugin": "^5.10.0",
      "@typescript-eslint/parser": "^5.10.0",
      "@vitejs/plugin-vue": "^5.2.4",
      "autoprefixer": "^10.4.2",
      "eslint": "^8.10.0",
      "eslint-config-prettier": "^8.1.0",
      "eslint-plugin-vue": "^9.0.0",
      "prettier": "^2.5.1",
      "typescript": "^5.8.3",
      "vite": "^6.3.5",
      "vue-tsc": "^2.2.10"
   },
   "engines": {
      "node": "^22",
      "npm": ">= 10.9.2",
      "yarn": ">=4.0.0"
   },
   "packageManager": "yarn@4.13.0+sha512.5c20ba010c99815433e5c8453112165e673f1c7948d8d2b267f4b5e52097538658388ebc9f9580656d9b75c5cc996f990f611f99304a2197d4c56d21eea370e7"
}
